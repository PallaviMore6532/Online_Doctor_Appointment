@model DailycollectionVM


<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">


            <form class="forms-sample" asp-action="Patientinformation" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>

                <div class="form-group col-md-8">
                    <label asp-for="FromDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="FromDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="FromDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-8">
                    <label asp-for="ToDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="ToDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="ToDate" class="text-danger"></span>
                    </div>
                </div>

               


                <button type="submit" class="btn btn-primary mr-2">ok</button>

            </form>
        </div>
    </div>
</div>


