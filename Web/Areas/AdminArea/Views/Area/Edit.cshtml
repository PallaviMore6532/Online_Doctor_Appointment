@model Area


<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Edit City</h4>

            <form class="forms-sample" asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <input type="hidden" asp-for="AreaID" />
                <div class="form-group row">
                    <label asp-for="AreaName" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="AreaName" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="AreaName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-sm-3 col-form-label">Select City</label>
                    <select class="form-control  border-dark" fdprocessedid="3v6q0k" asp-for="CityID" asp-items="@ViewBag.city">
                        <option>select City</option>

                    </select>
                    <span asp-validation-for="CityID" class="text-danger"></span>

                </div>

             
                <button type="submit" class="btn btn-primary mr-2">Edit</button>
                <button class="btn btn-light" asp-action="Index">Back</button>
            </form>
        </div>
    </div>
</div>

