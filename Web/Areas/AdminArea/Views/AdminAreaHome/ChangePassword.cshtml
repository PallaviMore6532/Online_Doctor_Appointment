@model ChangePasswordVM


<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Change Password</h4>

            <form class="forms-sample" asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <div class="form-group row">
                    <label asp-for="OldPassword" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="OldPassword" class="form-control border-dark">
                        <span asp-validation-for="OldPassword"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="NewPassword" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="NewPassword" class="form-control border-dark" >
                        <span asp-validation-for="NewPassword"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="ConfirmPassword" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="ConfirmPassword" class="form-control border-dark" >
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>

                <div class="form-check form-check-flat form-check-primary">
                    <label class="form-check-label">
                        <input type="checkbox" class="form-check-input">
                        Remember me
                        <i class="input-helper"></i>
                    </label>
                </div>
                <button type="submit" class="btn btn-primary mr-2">Create</button>
                <button class="btn btn-light" asp-action="Index">Back</button>
            </form>
        </div>
    </div>
</div>

