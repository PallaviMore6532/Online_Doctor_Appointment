@model ClinicFacility


<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Create State</h4>

            <form class="forms-sample" asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <div class="form-group row">
                    <label asp-for="ClinicFacilityName" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="ClinicFacilityName" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="ClinicFacilityName" class="text-danger"></span>
                    </div>
                </div>

                

               
                <button type="submit" class="btn btn-primary mr-2">Create</button>
                <button class="btn btn-light" asp-action="Index">Back</button>
            </form>
        </div>
    </div>
</div>

