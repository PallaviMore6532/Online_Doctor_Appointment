@model DailycollectionVM


<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">


            <form class="forms-sample" asp-action="Appointment" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>

                <div class="form-group col-md-8">
                    <label asp-for="FromDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="FromDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="FromDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-8">
                    <label asp-for="ToDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="ToDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="ToDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group col-md-3">
                    <label class="col-sm-3 col-form-label">Select Doctor</label>
                    <select class="form-control  border-dark" fdprocessedid="3v6q0k" asp-for="DoctorID" asp-items="@ViewBag.doctor">
                        <option>select Doctor</option>

                    </select>
                    <span asp-validation-for="DoctorID" class="text-danger"></span>

                </div>


                <button type="submit" class="btn btn-primary mr-2">ok</button>

            </form>
        </div>
    </div>
</div>



