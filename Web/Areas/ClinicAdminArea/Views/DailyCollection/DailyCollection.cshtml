@model IEnumerable<dailyPatientamtVM>

@{
	Layout = null;
}
<html>
	<head>
		<title> Daily collection report</title>
    <link rel="stylesheet" href="~/backendassets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/backendassets/vendors/feather/feather.css">
    <link rel="stylesheet" href="~/backendassets/vendors/base/vendor.bundle.base.css">
    <!-- endinject -->
    <!-- plugin css for this page -->
    <link rel="stylesheet" href="~/backendassets/vendors/flag-icon-css/css/flag-icon.min.css" />
    <link rel="stylesheet" href="~/backendassets/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/backendassets/vendors/jquery-bar-rating/fontawesome-stars-o.css">
    <link rel="stylesheet" href="~/backendassets/vendors/jquery-bar-rating/fontawesome-stars.css">
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <link rel="stylesheet" href="~/backendassets/css/style.css">
    <!-- endinject -->
    <link rel="shortcut icon" href="~/backendassets/images/favicon.png" />
	</head>
	<body>
         <div class="container">
              <div class="row">
                   <div class="col-md-12">
                        <br />
                <h2> Doctor Wise Collection Report </h2>
                <table class="table table-bordered border-primary">
                    <thead>
                        <tr>
                            <th>Sr no</th>
                            <th>Patient Name</th>
                            <th>Appointment Date</th>
                            <th>Amount</th>


                        </tr>
                    </thead>
                    <tbody>
                        @{
                           int srno = 1;
                            decimal finalamount = 0;
                        }
                        @foreach (var temp in Model)
                        {
                            <tr>
                                <td>@srno</td>
                                <td>@temp.PatientName</td>
                                <td>@temp.AppointmentDate</td>
                                <td>@temp.Amount</td>
                                <td>
                                    @{
                                        temp.Total = 0;
                                        decimal amt = temp.Total + temp.Amount;
                                        finalamount += amt;
                                    }
                                </td>


                            </tr>
                            srno++;

                        }
                        <tr>
                            <td colspan="3"> Total:</td>
                            <td>@finalamount</td>
                        </tr>

                    </tbody>
                </table>
                <input type="button" onclick="PrintReport()" class="btn btn-danger" value="Print" />
                   </div>
              </div>
         </div>
        <script type="text/javascript">
            function PrintReport() {
                window.print();
            }
        </script>
     	</body>
</html>
