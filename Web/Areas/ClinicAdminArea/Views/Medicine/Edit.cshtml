@model Medicine


<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Create State</h4>

            <form class="forms-sample" asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <input type="hidden" asp-for="MedicineID" />
                <div class="form-group row">
                    <label asp-for="MedicineName" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="MedicineName" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="MedicineName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="MfgName" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="MfgName" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="MfgName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="ExpDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="ExpDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="ExpDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="MfgDate" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="MfgDate" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="MfgDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Price" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="Price" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>





              
                <button type="submit" class="btn btn-primary mr-2">Edit</button>
                <button class="btn btn-light" asp-action="Index">Back</button>
            </form>
        </div>
    </div>
</div>

