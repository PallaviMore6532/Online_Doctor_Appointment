@model DoctorVm


<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Create State</h4>

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="FirstName" class="control-label"></label>
                    <input  asp-for="FirstName" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="LastName" class="control-label "></label>
                    <input asp-for="LastName" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="MobileNo" class="control-label "></label>
                    <input asp-for="MobileNo" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>
                <div class="form-group form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsAvailable" /> @Html.DisplayNameFor(model => model.IsAvailable)
                    </label>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="Address" class="control-label"></label>
                    <input asp-for="Address" class="form-control row col-sm-10 border-dark" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="DoctorExperiance" class="control-label"></label>
                    <input asp-for="DoctorExperiance" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="DoctorExperiance" class="text-danger"></span>
                </div>
              @*   <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="PhotoPath" class="control-label"></label>
                    <input asp-for="PhotoPath" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="PhotoPath" class="text-danger"></span>
                </div> *@
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="DoctorQualification" class="control-label"></label>
                    <input asp-for="DoctorQualification" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="DoctorQualification" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="VisitingCharges" class="control-label"></label>
                    <input asp-for="VisitingCharges" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="VisitingCharges" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 col-form-label" asp-for="Password" class="control-label"></label>
                    <input asp-for="Password" class="form-control row col-sm-4 border-dark" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group col-sm-6">
                    <label class="col-sm-3 col-form-label" asp-for="AreaID" class="control-label"></label>
                    <select asp-for="AreaID" asp-items="@ViewBag.area">Select Area</select>
                    
                    <span asp-validation-for="AreaID" class="text-danger"></span>
                </div>
              @*   <div class="form-group col-sm-6">
                    <label class="col-sm-3 col-form-label" asp-for="ClinicID" class="control-label"></label>
                    <select asp-for="ClinicID" asp-items="@ViewBag.clinic">Select Clinic</select>
                    <span asp-validation-for="ClinicID" class="text-danger"></span>
                </div> *@

                <div class="col-8">
                    <label asp-for="photo" class="form-label"></label>
                    <input asp-for="photo" type="file" class="form-control" />
                    <span asp-validation-for="photo" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="control-label"> select Facility</label>
                    @await Component.InvokeAsync("DoctorFacilitityVC")
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
         
        </div>
    </div>
</div>



