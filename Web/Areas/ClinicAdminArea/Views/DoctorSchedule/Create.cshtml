@model DoctorSchedule

<div class="col-lg-12">

          <div class="card">
            <div class="card-body">
              <h5 class="card-title">Create New</h5>
              
              <!-- Vertical Form -->
            <form class="row g-3" asp-action="Create" method="post" >
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <div class="col-8">
                   
                    <label asp-for="DayOfWeek" class="form-label"></label>
                    <select asp-for="DayOfWeek" asp-items="@Html.GetEnumSelectList<daysEnum>()">
                        <option>Select Day</option>
                    </select>
                   
                </div>

                <div class="col-8">
                    <label asp-for="StartTime" class="form-label"></label>
                    <input asp-for="StartTime" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="col-8">
                    <label asp-for="EndTime" class="form-label"></label>
                    <input asp-for="EndTime" class="form-control" />
                    <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                <div class="col-8">
                    <label asp-for="Interval" class="form-label"></label>
                    <input asp-for="Interval" class="form-control" />
                    <span asp-validation-for="Interval" class="text-danger"></span>
                </div>

                <div class="col-8">
                    <label class="form-label">Select Category</label>
                    <select asp-for="DoctorID" asp-items="@ViewBag.doctors" class="form-select">
                        <option>Select Doctor</option>
                    </select>
                    <span asp-validation-for="DoctorID" class="text-danger"></span>
                </div>

                <div class="col-8">
                    <label class="form-label">Select Category</label>
                    <select asp-for="OPDSessionID" asp-items="@ViewBag.opd" class="form-select">
                        <option>Select OPD</option>
                    </select>
                    <span asp-validation-for="OPDSessionID" class="text-danger"></span>
                </div>

                
                <div class="text-center">
                  <button type="submit" class="btn btn-primary">Submit</button>
                  <button type="reset" class="btn btn-secondary">Reset</button>
                </div>
              </form><!-- Vertical Form -->

            </div>
          </div>

</div>
