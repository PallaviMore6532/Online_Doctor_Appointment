@model DoctorScheduleVM


<h2>Doctor Schedule edit</h2>

 
<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Edit State</h4>

            <form class="forms-sample" asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger">
                </div>
                <input type="hidden" asp-for="doctorSpeciality.DoctorID" />
                <input type="hidden" asp-for="doctorSchedule.DoctorID" />
              @*   <input type="hidden" asp-for="doctorSchedule.DoctorScheduleID" /> *@
                <div class="form-group row">
                    <label asp-for="doctorSchedule.StartTime" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="doctorSchedule.StartTime" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="doctorSchedule.StartTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="doctorSchedule.EndTime" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="doctorSchedule.EndTime" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="doctorSchedule.EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="doctorSchedule.Interval" class="col-sm-3 col-form-label"></label>
                    <div class="col-sm-9">
                        <input asp-for="doctorSchedule.Interval" class="form-control  border-dark" placeholder="name">
                        <span asp-validation-for="doctorSchedule.Interval" class="text-danger"></span>
                    </div>
                </div>

                <div class="col-8">
                    <label class="form-label">Select Category</label>
                    <select asp-for="doctorSchedule.OPDSessionID" asp-items="@ViewBag.opd" class="form-select">
                        <option>Select OPD</option>
                    </select>
                    <span asp-validation-for="doctorSchedule.OPDSessionID" class="text-danger"></span>
                </div>

              
                <label asp-for="doctorSchedule.DayOfWeek" class="form-label"></label>
                <select asp-for="doctorSchedule.DayOfWeek" asp-items="@Html.GetEnumSelectList<daysEnum>()">
                    <option>Select Day</option>
                </select>





                <button type="submit" class="btn btn-primary mr-2">Edit</button>
                <button class="btn btn-light" asp-action="Index">Back</button>
            </form>
        </div>
    </div>
</div>