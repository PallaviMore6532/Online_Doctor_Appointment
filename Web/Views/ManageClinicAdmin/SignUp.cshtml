@model ClinicAdminCompoVM


<br />
<br />
<br />
<br />
<br />
<br />
@* <section class="regervation_part section_padding"> *@
    <div class="container">
        <div class="row align-items-center regervation_content">
            <div class="col-lg-7">
                <div class="regervation_part_iner">
                <form asp-action="Signup" method="post" enctype="multipart/form-data">

                    <div class="form-row">
                            <div class="form-group col-sm-4">
                                <label asp-for="ClinicName" class="Control-label"></label>
                                <input asp-for="ClinicName" class="form-control" />
                                <span asp-validation-for="ClinicName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-4">
                                <label asp-for="Address" class="control-label"></label>
                                <input asp-for="Address" class="form-control" />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                        <div class="col-8">
                            <label asp-for="Photo" class="form-label"></label>
                            <input asp-for="Photo" type="file" class="form-control" />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                        </div>

                            <div class="form-group col-sm-4">
                                <label asp-for="EmailID" class="control-label"></label>
                                <input asp-for="EmailID" class="form-control" />
                                <span asp-validation-for="EmailID" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="MobileNO" class="control-label"></label>
                                <input asp-for="MobileNO" class="form-control" />
                                <span asp-validation-for="MobileNO" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="ContactPersonName" class="control-label"></label>
                                <input asp-for="ContactPersonName" class="form-control" />
                                <span asp-validation-for="ContactPersonName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="RegisterDate" class="control-label"></label>
                                <input asp-for="RegisterDate" class="form-control" />
                                <span asp-validation-for="RegisterDate" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="LandLineNO" class="control-label"></label>
                                <input asp-for="LandLineNO" class="form-control" />
                                <span asp-validation-for="LandLineNO" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="WebsiteUrl" class="control-label"></label>
                                <input asp-for="WebsiteUrl" class="form-control" />
                                <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="CityID" class="control-label"></label>
                                <select asp-for="CityID" asp-items="@ViewBag.cities"></select>
                                <span asp-validation-for="CityID" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="FirstName" class="control-label"></label>
                                <input asp-for="FirstName" class="form-control" />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="LastName" class="control-label"></label>
                                <input asp-for="LastName" class="form-control" />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="AdminEmailID" class="control-label"></label>
                                <input asp-for="AdminEmailID" class="form-control" />
                                <span asp-validation-for="AdminEmailID" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="AdminMobileNo" class="control-label"></label>
                                <input asp-for="AdminMobileNo" class="form-control" />
                                <span asp-validation-for="AdminMobileNo" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="Password" class="control-label"></label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                            <div class="form-group col-sm-6">
                                <label asp-for="ConformPassword" class="control-label"></label>
                                <input asp-for="ConformPassword" class="form-control" />
                                <span asp-validation-for="ConformPassword" class="text-danger"></span>
                            </div>

                        <button class="btn_2" type="submit">Registration</button>

                    </div>
                    
                     
                       
                    </form>
                </div>
            </div>
            
        </div>
    </div>
@* </section> *@





