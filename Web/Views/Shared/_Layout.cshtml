<!-- ================= Layout Page ================= -->
<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Medico</title>
    <link rel="icon" href="~/frontendassets/img/favicon.png">
    <link rel="stylesheet" href="~/frontendassets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/frontendassets/css/style.css">
</head>

<body>
    <!-- Header with Navbar -->
    <header class="main_menu home_menu">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-light">
                <a class="navbar-brand" href="#">
                    <img src="~/frontendassets/img/logo.png" alt="logo"> <strong>Medico</strong>
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("UserID") != null)
                        {
                            <li class="nav-item">Hi! @Context.Session.GetString("UserName")</li>
                            <li class="nav-item"><a class="nav-link" asp-action="Index" asp-controller="UserAreaHome" asp-route-area="UserArea">Account</a></li>
                            <li class="nav-item"><a class="nav-link" asp-action="SignOut" asp-controller="ManageUsers">Logout</a></li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="usersDropdown" role="button" data-toggle="dropdown">Users</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-action="SignIn" asp-controller="ManageUsers">Log In</a>
                                    <a class="dropdown-item" asp-action="SignUp" asp-controller="ManageUsers">User Registration</a>
                                </div>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="clientsDropdown" role="button" data-toggle="dropdown">Clients Admin</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item" asp-action="SignIn" asp-controller="ManageClinicAdmin">Log In</a>
                                    <a class="dropdown-item" asp-action="SignUp" asp-controller="ManageClinicAdmin">Registration</a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <!-- Main content placeholder -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer Scripts -->
    <script src="~/frontendassets/js/jquery-1.12.1.min.js"></script>
    <script src="~/frontendassets/js/popper.min.js"></script>
    <script src="~/frontendassets/js/bootstrap.min.js"></script>
</body>
</html>
