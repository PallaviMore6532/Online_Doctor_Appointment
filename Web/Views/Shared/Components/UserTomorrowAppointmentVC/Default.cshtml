@model IEnumerable<Patient>

	<table class="table table-bordered border-primary">
		<thead>
		   <tr>
            <th>SR NO</th>
			<th>Patient ID</th>
			<th>First Name</th>
			<th>Last Name</th>
			<th>Address</th>
			<th>User ID</th>
	       </tr>
		</thead>

		<tbody>

		@{
			int srno = 1;
		}
			@foreach(var temp in Model)
			{
			<tr>
				<td>@srno</td>
				<td>@temp.PatientID</td>
				<td>@temp.FirstName</td>
				<td>@temp.LastName</td>
				<td>@temp.Address</td>
				<td>@temp.UserID</td>


				@* <td>
					<a asp-action="CreatePrescription" asp-controller="Prescription" asp-area="DoctorArea" asp-route-id="@temp.PatientID" asp-route-bid="@temp.BookedAppointmentID" class="btn btn-primary"> Create Prescription </a> |
					<a asp-action="EditPrescription" asp-controller="Prescription" asp-area="DoctorArea" asp-route-id="@temp.BookedAppointmentID"  class="btn btn-danger"> Edit Prescription </a>

				</td> *@
			</tr>
			srno++;
		}
		</tbody>
	</table>