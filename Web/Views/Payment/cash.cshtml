@model BookVM

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">Appointment Confirmation</h4>
                </div>
                <div class="card-body">
                    <table class="table table-striped table-bordered">
                        <tr>
                            <td><strong>Order Status</strong></td>
                            <td>@(Model.IsSuccess ? "Success" : "Failed")</td>
                        </tr>
                        <tr>
                            <td><strong>Message</strong></td>
                            <td>@Model.Message</td>
                        </tr>
                        <tr>
                            <td><strong>Patient ID</strong></td>
                            <td>@Model.PatientID</td>
                        </tr>
                        <tr>
                            <td><strong>Start Time</strong></td>
                            <td>@Model.StartTime</td>
                        </tr>
                        <tr>
                            <td><strong>Appointment Date</strong></td>
                            <td>@Model.AppointmentDate</td>
                        </tr>
                        <tr>
                            <td><strong>End Time</strong></td>
                            <td>@Model.EndTime</td>
                        </tr>
                        <tr>
                            <td><strong>Amount</strong></td>
                            <td>₹@Model.Amount</td>
                        </tr>
                    </table>
                    <div class="text-end">
                        <a asp-action="Success" asp-route-id="@Model.PatientID" class="btn btn-success">Continue</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
