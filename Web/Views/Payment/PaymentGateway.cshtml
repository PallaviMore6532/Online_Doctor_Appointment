@model PaymentGatewayVM
@{
    ViewData["Title"] = "Payment Gateway";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-primary">
                <div class="card-header bg-primary text-white text-center">
                    <h4 class="mb-0">Secure Payment Gateway</h4>
                </div>
                <div class="card-body">
                    <form asp-action="PaymentGateway" method="post">
                        <div class="mb-3">
                            <label asp-for="CardNo" class="form-label">Card Number</label>
                            <input asp-for="CardNo" class="form-control" placeholder="1234 5678 9012 3456" />
                            <span asp-validation-for="CardNo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ExpiryDate" class="form-label">Expiry Date</label>
                            <input asp-for="ExpiryDate" type="month" class="form-control" />
                            <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CVVCode" class="form-label">CVV</label>
                            <input asp-for="CVVCode" class="form-control" placeholder="123" />
                            <span asp-validation-for="CVVCode" class="text-danger"></span>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-success w-100">Make Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>