

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-info">
                <div class="card-header bg-info text-white text-center">
                    <h5>Select Payment Mode</h5>
                </div>
                <div class="card-body">
                    <form asp-action="FinalBook" asp-controller="Payment" method="post">
                        <div class="form-group">
                            <label for="PaymentMode" class="font-weight-bold">Choose a payment method:</label>
                            <select name="PaymentMode"
                                    class="form-control border-dark"
                                    asp-items="@Html.GetEnumSelectList<PaymentModeEnum>()">
                                <option value="">-- Select Payment Mode --</option>
                            </select>
                        </div>
                        <div class="text-center mt-4">
                            <input type="submit" value="Make Payment" class="btn btn-success px-4" />
                            <a asp-action="AddPatient" asp-controller="Home" class="btn btn-secondary ml-2">← Back</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

