@model DoctorSchedule

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Doctor Schedule Details</title>
    <link rel="stylesheet" href="~/frontendassets/css/bootstrap.min.css" />
</head>
<body>
    <div class="container mt-5">
        <div class="card shadow-sm border-info">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Doctor Schedule Details</h4>
                @*   <a asp-action="GetDoctorSpeciality" asp-controller="Home" class="btn btn-light btn-sm">← Back</a> *@
                <a asp-action="BookAppointment"
                   asp-controller="Home"
                   asp-route-id="@Context.Session.GetString("ClinicID")"
                   class="btn btn-secondary">
                    ← Back
                </a>

            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Doctor Schedule ID</dt>
                    <dd class="col-sm-8">@Context.Session.GetString("DoctorScheduleID")</dd>

                    <dt class="col-sm-4">Day of Week</dt>
                    <dd class="col-sm-8">@Model.DayOfWeek.ToString()</dd>

                    <dt class="col-sm-4">Start Date</dt>
                    <dd class="col-sm-8">@Model.StartTime</dd>

                    <dt class="col-sm-4">End Date</dt>
                    <dd class="col-sm-8">@Model.EndTime</dd>

                    <dt class="col-sm-4">Interval (minutes)</dt>
                    <dd class="col-sm-8">@Model.Interval</dd>

                    <dt class="col-sm-4">OPD Session</dt>
                    <dd class="col-sm-8">@Model.OpdSession?.SessionName</dd>

                    <dt class="col-sm-4">Doctor Visiting Charges</dt>
                    <dd class="col-sm-8">₹@Context.Session.GetString("VisitingCharges")</dd>
                </dl>
            </div>
            <div class="card-footer text-end">
                <a asp-action="AddPatient" asp-controller="Home" class="btn btn-primary">Book Appointment</a>
            </div>
        </div>
    </div>
</body>
</html>






