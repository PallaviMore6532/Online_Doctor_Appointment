@model IEnumerable<Clinic>

<div class="container mt-5">
    <div class="row mb-4">
        @using (Html.BeginForm("searchByName", "Home", FormMethod.Get))
        {
            <div class="form-row w-100">
                <div class="col-md-4">
                    @Html.DropDownList("sname", null, "Select Specialist", new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    @Html.DropDownList("aname", null, "Select Area", new { @class = "form-control" })
                </div>
                <div class="col-md-4">
                    <input type="submit" value="Search" class="btn btn-primary w-100" />
                </div>
            </div>
        }
    </div>

    <div class="row">
        @foreach (var temp in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card p-3 shadow-sm border border-light">
                    <div class="card-body">
                        <h5 class="card-title font-weight-bold">@temp.ClinicName</h5>
                        <p class="card-text mb-1"><strong>Address:</strong> @temp.Address</p>
                        <p class="card-text mb-3">
                            <strong>Clinic Rating:</strong>
                            @if (temp.ClinicRatings != null && temp.ClinicRatings.Any())
                            {
                                var avgRating = temp.ClinicRatings.Average(r => r.Rating);
                                <span>@avgRating.ToString("0.0") ★</span>
                            }
                            else
                            {
                                <span>No ratings yet</span>
                            }
                        </p>
                        <a asp-action="BookAppointment" asp-route-id="@temp.ClinicID" asp-controller="Home" class="btn btn-success">Book</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
